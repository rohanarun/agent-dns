# Written for you by deploy/deploy-gcp.sh; shown here for reference.

# The VM's static external IP. Every hostname resolves to this.
FROZEN_PUBLIC_IP=34.0.0.1

# Default "web as of" date (YYYYMMDD). Nothing captured after this day is ever served.
FROZEN_SNAPSHOT=20260601

# Bearer token for /admin endpoints (per-agent snapshots, full logs).
FROZEN_ADMIN_TOKEN=change-me

# Comma-separated hosts that reach the real internet (subdomains included). Empty = sealed.
# e.g. pypi.org,files.pythonhosted.org,registry.npmjs.org
FROZEN_PASSTHROUGH=

# Archive sources, in order.
FROZEN_SOURCES=commoncrawl,wayback

# Interface the DNS server binds to (the VM's internal IP; set automatically).
FROZEN_DNS_BIND=0.0.0.0
